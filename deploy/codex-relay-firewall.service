[Unit]
Description=Allow the dedicated public Codex Relay HTTPS port
Before=codex-relay.service
After=private-admission.service
PartOf=private-admission.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/codex-relay/allow-public-port.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
